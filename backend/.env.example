DATABASE_URL=postgresql+asyncpg://gains:gains@localhost:5432/gains
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth client ID ("Web application" type; the client secret is not needed)
GOOGLE_CLIENT_ID=
# Signs login session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false
# Optional comma-separated allowlist; empty means any Google account may sign in
ALLOWED_EMAILS=
